msgid "Sequence Analysis Dashboard"
msgstr "Painel de Análise de Sequências"

msgid "Data & Variables"
msgstr "Dados e Variáveis"

msgid "Variables (Sequence states over time)"
msgstr "Variáveis (Estados da sequência ao longo do tempo)"

msgid "Identifier (Optional, e.g., Patient/Subject ID)"
msgstr "Identificador (Opcional, ex., ID do Paciente/Sujeito)"

msgid "Missing Data Handling"
msgstr "Tratamento de Dados Ausentes"

msgid "Left gaps (Before sequence starts)"
msgstr "Lacunas à esquerda (Antes de iniciar a sequência)"

msgid "Void gaps (Internal missing data)"
msgstr "Lacunas vazias (Dados perdidos internos)"

msgid "Right gaps (After sequence ends)"
msgstr "Lacunas à direita (Após terminar a sequência)"

msgid "Delete / Ignore (DEL)"
msgstr "Excluir / Ignorar (DEL)"

msgid "Treat as missing (NA)"
msgstr "Tratar como ausente (NA)"

msgid "Dashboard Plots"
msgstr "Gráficos do Painel"

msgid "State Distribution Plot (seqdplot)"
msgstr "Gráfico de Distribuição de Estados (seqdplot)"

msgid "Sequence Frequency Plot (seqfplot)"
msgstr "Gráfico de Frequência de Sequências (seqfplot)"

msgid "Sequence Index Plot (seqIplot)"
msgstr "Gráfico de Índice de Sequências (seqIplot)"

msgid "Mean Time Plot (seqmtplot)"
msgstr "Gráfico de Tempo Médio (seqmtplot)"

msgid "Smart Column Selection (tidyselect)"
msgstr "Seleção Inteligente de Colunas (tidyselect)"

msgid "None (Use manual selection above)"
msgstr "Nenhum (Usar seleção manual acima)"

msgid "starts_with() - Exact prefix"
msgstr "starts_with() - Prefixo exato"

msgid "ends_with() - Exact suffix"
msgstr "ends_with() - Sufixo exato"

msgid "contains() - Literal string"
msgstr "contains() - Texto literal"

msgid "matches() - Regular expression"
msgstr "matches() - Expressão regular"

msgid "Custom (Raw tidyselect expression)"
msgstr "Personalizado (Expressão tidyselect pura)"

msgid "Value / Pattern (No quotes needed for prefix/suffix)"
msgstr "Valor / Padrão (Não precisa de aspas para prefixo/sufixo)"

# =========================================================
# COMPONENTE 2: Sequence Clustering
# =========================================================
msgid "Sequence Clustering"
msgstr "Clustering de Sequências"

msgid "Sequence Clustering & Typology"
msgstr "Clustering e Tipologia de Sequências"

msgid "Data & Covariates"
msgstr "Dados e Covariáveis"

msgid "Cross-tabulation"
msgstr "Tabulação Cruzada"

msgid "Clustering Settings"
msgstr "Configurações de Clustering"

msgid "<b>Method:</b> Optimal Matching (Constant Cost) to Ward Hierarchical Clustering"
msgstr "<b>Método:</b> Emparelhamento Ótimo (Custo Constante) e Clustering Hierárquico de Ward"

msgid "Number of clusters (k)"
msgstr "Número de clusters (k)"

msgid "Save cluster factor as (column name)"
msgstr "Salvar fator de cluster como (nome da coluna)"

msgid "Append cluster factor to original dataframe"
msgstr "Adicionar fator de cluster ao data frame original"

msgid "Save Clustering Model (hclust) as"
msgstr "Salvar Modelo de Clustering (hclust) como"

msgid "State Distribution Plot by Cluster (ggseqplot)"
msgstr "Gráfico de Distribuição de Estados por Cluster (ggseqplot)"

msgid "Hierarchical Dendrogram (hclust)"
msgstr "Dendrograma Hierárquico (hclust)"

msgid "Cross-Tabulation: Covariates by Cluster"
msgstr "Tabulação Cruzada: Covariáveis por Cluster"

msgid "<b>Covariate:</b>"
msgstr "<b>Covariável:</b>"

msgid "<span style='color:red;'>Note: Base R Dendrograms cannot be saved as plot objects.</span>"
msgstr "<span style='color:red;'>Nota: Os Dendrogramas do R Base não podem ser salvos como objetos gráficos.</span>"


