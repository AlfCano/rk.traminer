msgid "Sequence Analysis Dashboard"
msgstr "Tableau de Bord d'Analyse de Séquences"

msgid "Data & Variables"
msgstr "Données et Variables"

msgid "Variables (Sequence states over time)"
msgstr "Variables (États de la séquence dans le temps)"

msgid "Identifier (Optional, e.g., Patient/Subject ID)"
msgstr "Identifiant (Optionnel, ex., ID Patient/Sujet)"

msgid "Missing Data Handling"
msgstr "Gestion des Données Manquantes"

msgid "Left gaps (Before sequence starts)"
msgstr "Lacunes à gauche (Avant le début de la séquence)"

msgid "Void gaps (Internal missing data)"
msgstr "Lacunes vides (Données manquantes internes)"

msgid "Right gaps (After sequence ends)"
msgstr "Lacunes à droite (Après la fin de la séquence)"

msgid "Delete / Ignore (DEL)"
msgstr "Supprimer / Ignorer (DEL)"

msgid "Treat as missing (NA)"
msgstr "Traiter comme manquant (NA)"

msgid "Dashboard Plots"
msgstr "Graphiques du Tableau de Bord"

msgid "State Distribution Plot (seqdplot)"
msgstr "Graphique de Distribution des États (seqdplot)"

msgid "Sequence Frequency Plot (seqfplot)"
msgstr "Graphique de Fréquence des Séquences (seqfplot)"

msgid "Sequence Index Plot (seqIplot)"
msgstr "Graphique d'Index des Séquences (seqIplot)"

msgid "Mean Time Plot (seqmtplot)"
msgstr "Graphique du Temps Moyen (seqmtplot)"

msgid "Smart Column Selection (tidyselect)"
msgstr "Sélection Intelligente de Colonnes (tidyselect)"

msgid "None (Use manual selection above)"
msgstr "Aucun (Utiliser la sélection manuelle ci-dessus)"

msgid "starts_with() - Exact prefix"
msgstr "starts_with() - Préfixe exact"

msgid "ends_with() - Exact suffix"
msgstr "ends_with() - Suffixe exact"

msgid "contains() - Literal string"
msgstr "contains() - Chaîne littérale"

msgid "matches() - Regular expression"
msgstr "matches() - Expression régulière"

msgid "Custom (Raw tidyselect expression)"
msgstr "Personnalisé (Expression tidyselect brute)"

msgid "Value / Pattern (No quotes needed for prefix/suffix)"
msgstr "Valeur / Modèle (Pas besoin de guillemets pour le préfixe/suffixe)"

msgid "Sequence Clustering"
msgstr "Clustering de Séquences"

msgid "Sequence Clustering & Typology"
msgstr "Clustering et Typologie de Séquences"

msgid "Data & Covariates"
msgstr "Données et Covariables"

msgid "Cross-tabulation"
msgstr "Tableau Croisé"

msgid "Clustering Settings"
msgstr "Paramètres de Clustering"

msgid "<b>Method:</b> Optimal Matching (Constant Cost) to Ward Hierarchical Clustering"
msgstr "<b>Méthode:</b> Appariement Optimal (Coût Constant) et Clustering Hiérarchique de Ward"

msgid "Number of clusters (k)"
msgstr "Nombre de clusters (k)"

msgid "Save cluster factor as (column name)"
msgstr "Enregistrer le facteur de cluster sous (nom de colonne)"

msgid "Append cluster factor to original dataframe"
msgstr "Ajouter le facteur de cluster au dataframe original"

msgid "Save Clustering Model (hclust) as"
msgstr "Enregistrer le Modèle de Clustering (hclust) sous"

msgid "State Distribution Plot by Cluster (ggseqplot)"
msgstr "Graphique de Distribution des États par Cluster (ggseqplot)"

msgid "Hierarchical Dendrogram (hclust)"
msgstr "Dendrogramme Hiérarchique (hclust)"

msgid "Cross-Tabulation: Covariates by Cluster"
msgstr "Tableau Croisé : Covariables par Cluster"

msgid "<b>Covariate:</b>"
msgstr "<b>Covariable :</b>"

msgid "<span style='color:red;'>Note: Base R Dendrograms cannot be saved as plot objects.</span>"
msgstr "<span style='color:red;'>Remarque : Les Dendrogrammes R Base ne peuvent pas être enregistrés en tant qu'objets graphiques.</span>"

